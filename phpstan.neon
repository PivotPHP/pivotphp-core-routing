includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: 9
    paths:
        - src
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # Allow static methods in Router class (by design)
        - '#Call to static method [a-zA-Z]+\(\) on class PivotPHP\\Routing\\Router#'

        # Ignore type casting redundancy (PHPDoc already ensures type safety)
        - '#Casting to .+ something that''s already#'
        - '#Call to function is_string\(\) with string will always evaluate to true#'
        - '#Call to function is_bool\(\) with .+ will always evaluate to true#'
        - '#Call to function is_callable\(\) with callable.* will always evaluate to true#'

        # Ignore unknown external classes (optional dependencies from pivotphp-core)
        - '#unknown class PivotPHP\\Core#'
        - '#Call to static method .+ on an unknown class PivotPHP\\Core#'

        # Route handlers are intentionally typed callable|array (matching the
        # PivotPHP\Core public API); the array-callable shape is validated and
        # narrowed inside add() via CallableResolver.
        - '#Method PivotPHP\\Routing\\Router\\Router::(add|get|post|put|delete|patch|options|head|any)\(\) has parameter \$handler with no value type specified in iterable type array#'

        # Route data is intentionally returned as loose arrays (identify/getRoutes)
        # to match the PivotPHP\Core consumer, whose phpstan config treats
        # explicit array value types as "mixed" errors. See pivotphp-core/phpstan.neon.
        - '#Method PivotPHP\\Routing\\Router\\Router::(identify|getRoutes)\(\) return type has no value type specified in iterable type array#'
