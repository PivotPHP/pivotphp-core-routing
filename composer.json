{
    "name": "pivotphp/core-routing",
    "description": "Simple, focused routing engine for PivotPHP - Express.js-inspired API (PSR-7)",
    "type": "library",
    "keywords": [
        "php",
        "routing",
        "router",
        "express",
        "framework",
        "pivotphp",
        "psr-7"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Caio Alberto Fernandes"
        }
    ],
    "require": {
        "php": "^8.1",
        "psr/http-message": "^1.1|^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^10.5.62|^11.5.50",
        "squizlabs/php_codesniffer": "^3.13.6"
    },
    "autoload": {
        "psr-4": {
            "PivotPHP\\Routing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PivotPHP\\Routing\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage",
        "phpstan": "phpstan analyse --no-progress",
        "cs:check": "phpcs --standard=phpcs.xml",
        "cs:fix": "phpcbf --standard=phpcs.xml",
        "quality:check": [
            "@phpstan",
            "@cs:check",
            "@test"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
