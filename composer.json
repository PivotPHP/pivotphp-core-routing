{
    "name": "pivotphp/core-routing",
    "description": "Simple, focused routing engine for PivotPHP - Express.js-inspired API with PSR compliance",
    "type": "library",
    "keywords": ["php", "routing", "router", "express", "framework", "pivotphp", "psr-7", "psr-15"],
    "license": "MIT",
    "authors": [
        {
            "name": "Caio Alberto Fernandes"
        }
    ],
    "require": {
        "php": "^8.1",
        "psr/http-message": "^1.1|^2.0",
        "psr/http-server-middleware": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/container": "^1.1|^2.0",
        "psr/simple-cache": "^2.0|^3.0",
        "psr/cache": "^2.0|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0",
        "phpstan/phpstan": "^1.10",
        "phpstan/phpstan-strict-rules": "^1.5",
        "squizlabs/php_codesniffer": "^3.7",
        "friendsofphp/php-cs-fixer": "^3.48"
    },
    "autoload": {
        "psr-4": {
            "PivotPHP\\Routing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PivotPHP\\Routing\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage",
        "phpstan": "phpstan analyse src --level=9",
        "cs:check": "phpcs --standard=PSR12 src tests",
        "cs:fix": "phpcbf --standard=PSR12 src tests",
        "quality:check": [
            "@phpstan",
            "@cs:check",
            "@test"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
